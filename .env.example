PORT=3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_PARTNER_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
CORS_ORIGIN=*

# Fast2SMS OTP (https://www.fast2sms.com/dashboard/dev-api). For WhatsApp delivery enable Smart OTP in the Fast2SMS panel.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
OTP_TTL_MINUTES=5
# WhatsApp OTP (approved authentication/utility template in Fast2SMS). If both are set, OTP goes on WhatsApp instead of the SMS route.
FAST2SMS_WHATSAPP_MESSAGE_ID=
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
